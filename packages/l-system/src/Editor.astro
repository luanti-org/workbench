---
import Axe from '@lucide/astro/icons/axe';
import Code from '@lucide/astro/icons/code';
import Copy from '@lucide/astro/icons/copy';
import Dices from '@lucide/astro/icons/dices';
import FileInput from '@lucide/astro/icons/file-input';
import GitFork from '@lucide/astro/icons/git-fork';
import Link from '@lucide/astro/icons/link';
import LocateFixed from '@lucide/astro/icons/locate-fixed';
import Maximize from '@lucide/astro/icons/maximize';
import Minimize from '@lucide/astro/icons/minimize';
import Pencil from '@lucide/astro/icons/pencil';
import Shrub from '@lucide/astro/icons/shrub';
import SlidersHorizontal from '@lucide/astro/icons/sliders-horizontal';
import TreeDeciduous from '@lucide/astro/icons/tree-deciduous';
import TreePine from '@lucide/astro/icons/tree-pine';
import { TEMPLATES } from './lib/builder';
import { EXAMPLES } from './lib/examples';
import { DEFAULT_COLORS } from './lib/viewer';

const templateIcons = {
	broadleaf: TreeDeciduous,
	conifer: TreePine,
	branching: GitFork,
	dead: Axe,
	bush: Shrub,
} as const;

const ruleFields = [
	{ name: 'axiom', label: 'Axiom', help: 'Where drawing starts' },
	{ name: 'rules_a', label: 'Rules A', help: 'Replaces A / a' },
	{ name: 'rules_b', label: 'Rules B', help: 'Replaces B / b' },
	{ name: 'rules_c', label: 'Rules C', help: 'Replaces C / c' },
	{ name: 'rules_d', label: 'Rules D', help: 'Replaces D / d' },
];

const nodeFields = [
	{ name: 'trunk', label: 'Trunk', kind: 'trunk' },
	{ name: 'leaves', label: 'Leaves', kind: 'leaves' },
	{ name: 'leaves2', label: 'Leaves 2', kind: 'leaves2' },
	{ name: 'fruit', label: 'Fruit', kind: 'fruit' },
] as const;

const symbols: [string, string][] = [
	['G', 'move forward, pen up'],
	['F', 'move forward, draw trunk; inside [ ] a branch with leaves'],
	['f', 'move forward, draw a leaf'],
	['T', 'move forward, draw trunk only'],
	['R', 'move forward, place fruit'],
	['A–D', 'replace with rules set A–D'],
	['a–d', 'replace with A–D at 90/80/70/60%'],
	['+ −', 'yaw right / left'],
	['& ^', 'pitch down / up'],
	['/ *', 'roll right / left'],
	['[ ]', 'push / pop turtle state'],
];
---

<div class="mb-4 flex flex-wrap items-end justify-between gap-3">
	<div>
		<div class="breadcrumbs py-0 text-sm">
			<ul>
				<li><a href="/l-system">L-system trees</a></li>
				<li>Editor</li>
			</ul>
		</div>
		<h1 class="text-2xl font-bold">L-System Editor</h1>
		<p class="text-base-content/70 text-sm">
			Design trees for <code>core.spawn_tree</code> and <code>lsystem</code> decorations.
		</p>
	</div>
	<div class="flex flex-wrap gap-2">
		<button type="button" id="import-open" class="btn btn-sm">
			<FileInput size={16} aria-hidden="true" /> Import Lua
		</button>
		<button type="button" id="share" class="btn btn-sm">
			<Link size={16} aria-hidden="true" /> Copy link
		</button>
	</div>
</div>

<div class="grid gap-4 lg:grid-cols-[24rem_1fr]">
	<form id="treedef" class="flex min-w-0 flex-col gap-4" autocomplete="off">
		<div role="tablist" class="tabs tabs-box">
			<button type="button" role="tab" class="tab tab-active flex-1 gap-2" data-mode="builder" aria-selected="true">
				<SlidersHorizontal size={16} aria-hidden="true" /> Builder
			</button>
			<button type="button" role="tab" class="tab flex-1 gap-2" data-mode="advanced" aria-selected="false">
				<Code size={16} aria-hidden="true" /> Rules
			</button>
		</div>

		<!-- Builder ------------------------------------------------------------------>
		<section id="builder-panel" class="flex flex-col gap-4">
			<fieldset class="fieldset bg-base-200 rounded-box p-4">
				<legend class="fieldset-legend">Tree type</legend>
				<div class="grid grid-cols-2 gap-2">
					{
						TEMPLATES.map((t) => {
							const Icon = templateIcons[t.id as keyof typeof templateIcons];
							return (
								<button
									type="button"
									data-template={t.id}
									class="btn btn-sm h-auto justify-start gap-2 py-2"
									aria-pressed="false"
								>
									<Icon size={18} aria-hidden="true" />
									{t.name}
								</button>
							);
						})
					}
					<button
						type="button"
						data-template="custom"
						class="btn btn-sm h-auto justify-start gap-2 py-2"
						aria-pressed="false"
					>
						<Pencil size={18} aria-hidden="true" />
						Custom
					</button>
				</div>
				{
					TEMPLATES.map((t) => (
						<p data-template-description={t.id} class="text-base-content/70 mt-1 hidden text-xs">
							{t.description}
						</p>
					))
				}
				<p data-template-description="custom" class="text-base-content/70 mt-1 hidden text-xs">
					Your own rules: written in the Rules tab, loaded from an example or imported. Switching to another
					type and back keeps them.
				</p>
				{
					[...TEMPLATES.map((t) => t.id), 'custom'].map((id) => {
						const examples = EXAMPLES.map((ex, i) => ({ ex, i })).filter(({ ex }) =>
							'def' in ex ? id === 'custom' : ex.template === id,
						);
						return (
							examples.length > 0 && (
								<div data-template-examples={id} class="mt-1 hidden flex-wrap items-center gap-1">
									<span class="text-base-content/60 mr-1 text-xs">Examples:</span>
									{examples.map(({ ex, i }) => (
										<button type="button" data-example={i} class="btn btn-xs btn-soft btn-primary">
											{ex.name}
										</button>
									))}
								</div>
							)
						);
					})
				}
			</fieldset>

			<fieldset id="builder-params" class="fieldset bg-base-200 rounded-box p-4">
				<legend class="fieldset-legend">Shape</legend>
				{
					TEMPLATES.map((t) => (
						<div data-template-params={t.id} class="hidden flex-col gap-3">
							{t.params.map((p) => (
								<div class="flex flex-col gap-1">
									{p.type === 'range' && (
										<label class="flex flex-col gap-1">
											<span class="flex justify-between text-xs">
												<span>{p.label}</span>
												<span class="font-mono">
													<output data-output-for={p.key} />
													{p.unit ? ` ${p.unit}` : ''}
												</span>
											</span>
											<input
												type="range"
												data-param={p.key}
												min={p.min}
												max={p.max}
												step={p.step}
												class="range range-xs range-primary"
											/>
										</label>
									)}
									{p.type === 'select' && (
										<label class="flex flex-col gap-1">
											<span class="text-xs">{p.label}</span>
											<select data-param={p.key} class="select select-sm w-full">
												{p.options.map((o) => (
													<option value={o.value}>{o.label}</option>
												))}
											</select>
										</label>
									)}
									{p.type === 'toggle' && (
										<label class="label cursor-pointer gap-2 text-sm">
											<input type="checkbox" data-param={p.key} class="toggle toggle-sm toggle-primary" />
											{p.label}
										</label>
									)}
									{p.help && <span class="text-base-content/60 text-xs">{p.help}</span>}
								</div>
							))}
						</div>
					))
				}
				<div data-template-params="custom" class="hidden flex-col gap-3">
					<p class="text-base-content/70 text-xs">
						These change how your rules are drawn without rewriting them. To change the shape itself, edit
						the rules in the <button type="button" class="link" data-mode-link="advanced">Rules tab</button>.
					</p>
					<label class="flex flex-col gap-1">
						<span class="flex justify-between text-xs">
							<span>Turn angle</span>
							<span class="font-mono"><output data-custom-output="angle"></output> °</span>
						</span>
						<input type="range" data-custom="angle" min="1" max="120" step="1" class="range range-xs range-primary" />
						<span class="text-base-content/60 text-xs">How far every turn symbol turns.</span>
					</label>
					<label class="flex flex-col gap-1">
						<span class="flex justify-between text-xs">
							<span>Growth steps</span>
							<span class="font-mono"><output data-custom-output="iterations"></output></span>
						</span>
						<input type="range" data-custom="iterations" min="2" max="8" step="1" class="range range-xs range-primary" />
						<span class="text-base-content/60 text-xs">
							How many times the rules are applied. Each step can make the tree much bigger.
						</span>
					</label>
					<label class="flex flex-col gap-1">
						<span class="flex justify-between text-xs">
							<span>Size variation</span>
							<span class="font-mono"><output data-custom-output="random_level"></output></span>
						</span>
						<input type="range" data-custom="random_level" min="0" max="4" step="1" class="range range-xs range-primary" />
						<span class="text-base-content/60 text-xs">Some trees get up to this many growth steps fewer.</span>
					</label>
					<label class="flex flex-col gap-1">
						<span class="text-xs">Trunk thickness</span>
						<select data-custom="trunk_type" class="select select-sm w-full">
							<option value="single">1 node</option>
							<option value="double">2×2</option>
							<option value="crossed">Cross (3 wide)</option>
						</select>
					</label>
					<label class="label cursor-pointer gap-2 text-sm">
						<input type="checkbox" data-custom="thin_branches" class="toggle toggle-sm toggle-primary" />
						Thin (1 node) branches
					</label>
				</div>
			</fieldset>
			<ul id="builder-notes" class="flex flex-col gap-1 text-sm"></ul>
			<p class="text-base-content/70 text-xs">
				Curious how it works? Open the{' '}
				<button type="button" class="link" data-mode-link="advanced">Rules tab</button> to see the rules this
				makes, and hover any symbol to light up what it draws.
			</p>
		</section>

		<!-- Advanced ------------------------------------------------------------------->
		<section id="advanced-panel" class="hidden flex-col gap-4">
			<fieldset class="fieldset bg-base-200 rounded-box p-4">
				<legend class="fieldset-legend">Rules</legend>
				<p class="text-base-content/70 text-xs">
					Hover or click a symbol to light up the blocks it draws. Hover a block in the preview to find the
					symbol that drew it.
				</p>
				{
					ruleFields.map(({ name, label, help }) => (
						<label class="flex flex-col gap-1">
							<span class="flex justify-between text-xs">
								<span>{label}</span>
								<span class="text-base-content/50">{help}</span>
							</span>
							<span class="code-field" data-code-field={name}>
								<span class="code-backdrop" aria-hidden="true" />
								<textarea name={name} rows="2" spellcheck="false" class="textarea textarea-sm w-full" />
							</span>
						</label>
					))
				}
				<details class="mt-2 text-xs">
					<summary class="cursor-pointer select-none">Symbol reference</summary>
					<dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1">
						{
							symbols.map(([sym, desc]) => (
								<>
									<dt class="font-mono font-semibold">{sym}</dt>
									<dd class="text-base-content/70">{desc}</dd>
								</>
							))
						}
					</dl>
				</details>
			</fieldset>

			<fieldset class="fieldset bg-base-200 rounded-box p-4">
				<legend class="fieldset-legend">Growth</legend>
				<div class="grid grid-cols-2 gap-3">
					<label class="flex flex-col gap-1">
						<span class="label text-xs">Angle (°)</span>
						<input name="angle" type="number" min="-32768" max="32767" class="input input-sm" />
					</label>
					<label class="flex flex-col gap-1">
						<span class="label text-xs">Iterations</span>
						<input name="iterations" type="number" min="2" max="32767" class="input input-sm" />
					</label>
					<label class="flex flex-col gap-1">
						<span class="label text-xs">Random level</span>
						<input name="random_level" type="number" min="0" max="32767" class="input input-sm" />
					</label>
					<label class="flex flex-col gap-1">
						<span class="label text-xs">Trunk type</span>
						<select name="trunk_type" class="select select-sm">
							<option value="single">single (1 node)</option>
							<option value="double">double (2×2)</option>
							<option value="crossed">crossed (3×3 cross)</option>
						</select>
					</label>
				</div>
				<label class="label mt-2 cursor-pointer gap-2 text-sm">
					<input name="thin_branches" type="checkbox" class="checkbox checkbox-sm" />
					Thin (1 node) branches
				</label>
			</fieldset>
		</section>

		<!-- Shared ---------------------------------------------------------------------->
		<fieldset class="fieldset bg-base-200 rounded-box p-4">
			<legend class="fieldset-legend">Nodes</legend>
			{
				nodeFields.map(({ name, label, kind }) => (
					<div class="flex items-end gap-2">
						<label class="flex flex-1 flex-col gap-1">
							<span class="label text-xs">{label}</span>
							<input name={name} type="text" class="input input-sm font-mono" />
						</label>
						<input
							type="color"
							data-color={kind}
							value={DEFAULT_COLORS[kind]}
							class="h-8 w-10 cursor-pointer rounded"
							title={`Preview color for ${label.toLowerCase()}`}
							aria-label={`Preview color for ${label.toLowerCase()}`}
						/>
					</div>
				))
			}
			<div class="mt-1 grid grid-cols-2 gap-3">
				<label class="flex flex-col gap-1">
					<span class="label text-xs">Leaves 2 chance (%)</span>
					<input name="leaves2_chance" type="number" min="0" max="100" class="input input-sm" />
				</label>
				<label class="flex flex-col gap-1">
					<span class="label text-xs">Fruit chance (%)</span>
					<input name="fruit_chance" type="number" min="0" max="100" class="input input-sm" />
				</label>
			</div>
		</fieldset>

		<fieldset class="fieldset bg-base-200 rounded-box p-4">
			<legend class="fieldset-legend">Seed</legend>
			<div class="flex items-end gap-2">
				<input name="seed" type="number" class="input input-sm flex-1" placeholder="random each time" aria-label="Seed" />
				<button type="button" id="reroll" class="btn btn-sm btn-square" title="New random seed" aria-label="New random seed">
					<Dices size={16} aria-hidden="true" />
				</button>
			</div>
			<p class="text-base-content/60 text-xs">
				In-game, a seed gives a tree like the preview, but the random details (leaves, chance rules, small
				angle wobble) are rolled differently.
			</p>
		</fieldset>
	</form>

	<div class="flex min-w-0 flex-col gap-4">
		<div id="viewer-frame" class="bg-base-200 rounded-box relative h-[60vh] min-h-80 overflow-hidden">
			<div id="viewer" class="absolute inset-0"></div>
			<div id="stats" class="bg-base-100/80 rounded-field pointer-events-none absolute top-2 left-2 px-2 py-1 font-mono text-xs whitespace-pre"></div>
			<div class="absolute top-2 right-2 flex items-center gap-2">
				<span id="busy" class="loading loading-spinner loading-sm hidden"></span>
				<button type="button" id="fit" class="btn btn-sm btn-square" title="Reset camera" aria-label="Reset camera">
					<LocateFixed size={16} aria-hidden="true" />
				</button>
				<button type="button" id="fullscreen" class="btn btn-sm btn-square" title="Full screen" aria-label="Full screen">
					<span data-fullscreen-icon="enter"><Maximize size={16} aria-hidden="true" /></span>
					<span data-fullscreen-icon="exit" class="hidden"><Minimize size={16} aria-hidden="true" /></span>
				</button>
			</div>
			<div
				id="inspect"
				class="bg-base-100/90 rounded-field pointer-events-none absolute right-2 bottom-2 left-2 px-3 py-2 text-sm"
				aria-live="polite"
			>
			</div>
		</div>

		<ul id="diagnostics" class="flex flex-col gap-1 text-sm"></ul>

		<div class="bg-base-200 rounded-box p-4">
			<div class="mb-2 flex items-center justify-between gap-2">
				<div role="tablist" class="tabs tabs-box tabs-sm">
					<button type="button" role="tab" class="tab tab-active" data-output="spawn">spawn_tree</button>
					<button type="button" role="tab" class="tab" data-output="decoration">Decoration</button>
				</div>
				<button type="button" id="copy" class="btn btn-sm">
					<Copy size={16} aria-hidden="true" /> Copy
				</button>
			</div>
			<pre id="output" class="bg-base-100 rounded-field overflow-x-auto p-3 text-sm"><code></code></pre>
		</div>
	</div>
</div>

<dialog id="import-dialog" class="modal">
	<div class="modal-box">
		<h3 class="mb-2 text-lg font-bold">Import treedef</h3>
		<p class="text-base-content/70 mb-2 text-sm">Paste a Lua treedef table (or code that contains one).</p>
		<textarea id="import-text" rows="10" spellcheck="false" class="textarea w-full font-mono text-xs"></textarea>
		<p id="import-message" class="text-warning mt-1 text-xs"></p>
		<div class="modal-action">
			<form method="dialog"><button type="submit" class="btn btn-ghost">Cancel</button></form>
			<button type="button" id="import-apply" class="btn btn-primary">Import</button>
		</div>
	</div>
	<form method="dialog" class="modal-backdrop"><button type="submit">close</button></form>
</dialog>

<style is:global>
	/* A textarea over a backdrop that mirrors its text, so characters can be
	   highlighted. Both must lay text out identically. */
	.code-field {
		position: relative;
		display: block;
		background: var(--color-base-100);
		border-radius: var(--radius-field);
	}
	.code-field > textarea,
	.code-field > .code-backdrop {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.8125rem;
		line-height: 1.5;
		letter-spacing: 0;
		padding: 0.375rem 0.75rem;
		border-width: 1px;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		word-break: break-all;
	}
	.code-field > textarea {
		position: relative;
		z-index: 1;
		background: transparent;
		min-height: 0;
		height: auto;
	}
	.code-field > .code-backdrop {
		position: absolute;
		inset: 0;
		overflow: hidden;
		border-color: transparent;
		color: transparent;
		border-radius: inherit;
	}
	.code-backdrop .hl {
		background: color-mix(in oklab, var(--color-primary) 22%, transparent);
	}
	.code-backdrop .hl-strong {
		background: color-mix(in oklab, var(--color-primary) 55%, transparent);
		border-radius: 2px;
	}
</style>

<script>
	import { mountEditor } from './editor';

	mountEditor();
</script>
