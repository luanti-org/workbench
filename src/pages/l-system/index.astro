---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ExternalLink from '@lucide/astro/icons/external-link';
import Layout from '../../layouts/Layout.astro';

const LUA_API =
	'https://github.com/luanti-org/luanti/blob/master/doc/lua_api.md';

const sections = [
	{
		title: 'L-system trees',
		anchor: 'l-system-trees',
		description: 'overview + example',
	},
	{
		title: 'Tree definition',
		anchor: 'tree-definition',
		description: 'All the rules',
	},
	{
		title: 'Symbols',
		anchor: 'key-for-special-l-system-symbols-used-in-axioms',
		description: 'Each rule explained',
	},
	{
		title: 'core.spawn_tree',
		anchor: 'environment-access',
		description: 'Spawn an l-system tree at a position or onto a VoxelManip',
		note: 'Under Environment access',
	},
	{
		title: 'lsystem decorations',
		anchor: 'lsystem',
		description: 'Use l-systems to spawn trees in mapgen',
		note: 'See also Decoration definition',
	},
];
---

<Layout title="L-System Trees">
	<div class="mx-auto max-w-3xl">
		<h1 class="mb-2 text-3xl font-bold">L-system trees</h1>
		<p class="text-base-content/80 mb-8 text-lg">
			Luanti can grow trees from an L-system: a short dynamic definition for a tree/bush/etc.
		</p>

		<h2 class="mb-3 text-xl font-semibold">From the docs</h2>
		<ul class="mb-10 grid gap-3 sm:grid-cols-2">
			{
				sections.map(({ title, anchor, description, note }) => (
					<li>
						<a
							href={`${LUA_API}#${anchor}`}
							target="_blank"
							rel="noopener"
							class="card card-border bg-base-100 hover:bg-base-200 h-full transition"
						>
							<div class="card-body gap-1 p-4">
								<span class="flex items-center gap-2 font-semibold">
									{title}
									<ExternalLink size={14} aria-hidden="true" class="text-base-content/50" />
								</span>
								<span class="text-base-content/70 text-sm">{description}</span>
								{note && <span class="text-base-content/50 text-xs">{note}</span>}
							</div>
						</a>
					</li>
				))
			}
		</ul>

		<nav aria-label="Next page">
			<a
				href="/l-system/editor"
				class="group border-primary/30 bg-primary/5 hover:border-primary/60 hover:bg-primary/10 rounded-box flex items-center gap-4 border px-5 py-4 transition"
			>
				<span class="flex min-w-0 flex-1 flex-col">
					<span class="text-base-content/60 text-xs tracking-wide uppercase">Next</span>
					<span class="text-primary text-lg font-semibold">L-System Editor</span>
					<span class="text-base-content/70 text-sm">Build a tree with sliders or your own rules.</span>
				</span>
				<span
					class="bg-primary text-primary-content grid size-10 shrink-0 place-items-center rounded-full transition group-hover:translate-x-1"
					aria-hidden="true"
				>
					<ArrowRight size={20} />
				</span>
			</a>
		</nav>
	</div>
</Layout>
